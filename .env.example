# Copy to .env in the repository root. Do not commit the real file.
# WorkSphere uses MongoDB. Install MongoDB locally or use Atlas.

NODE_ENV=development
HOST=127.0.0.1
PORT=4000

DATABASE_URL=mongodb://127.0.0.1:27017/screenvault

# Generate both secrets with a password manager. Each must be at least 32 characters.
JWT_SECRET=replace-with-a-random-string-at-least-32-characters
MEDIA_SIGNING_SECRET=replace-with-another-random-string-32-characters

CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001,http://localhost:3000,http://127.0.0.1:3000
PUBLIC_BASE_URL=http://127.0.0.1:4000

STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./data/storage

# S3-compatible storage. Leave unused for local development.
# STORAGE_DRIVER=s3
# S3_ENDPOINT=https://s3.example.com
# S3_REGION=us-east-1
# S3_BUCKET=screenvault
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=true

MAX_UPLOAD_BYTES=20971520
RETENTION_INTERVAL_MINUTES=60
LOG_LEVEL=info
TRUST_PROXY=false
RATE_LIMIT_DISABLED=false

ACCESS_TOKEN_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=1576800000

SEED_ORG_NAME=Northwind Studio
SEED_PASSWORD=ChangeMe-Please-1

# Admin console (apps/admin/.env.local). Next proxies /api/v1 to this URL.
# SCREENVAULT_API_URL=http://127.0.0.1:4000

# Desktop client override
# SCREENVAULT_API_URL=http://127.0.0.1:4000
